{
  "name": "sonota-mobile-angular",
  "version": "3.2.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0",
    "dev": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:android": "npm run build && npx cap sync android && npx cap open android",
    "cap:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "postbuild": "node scripts/copy-web.mjs"
  },
  "dependencies": {
    "@angular/animations": "20.3.32",
    "@angular/common": "20.3.32",
    "@angular/compiler": "20.3.32",
    "@angular/core": "20.3.32",
    "@angular/forms": "20.3.32",
    "@angular/platform-browser": "20.3.32",
    "@angular/router": "20.3.32",
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@ionic/angular": "8.8.19",
    "ionicons": "8.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.37",
    "@angular/cli": "20.3.37",
    "@angular/compiler-cli": "20.3.32",
    "@capacitor/cli": "8.5.2",
    "typescript": "5.9.3"
  }
}
