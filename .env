PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8100,http://127.0.0.1:8100
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
SESSION_HOURS=24
MAX_UPLOAD_MB=100
USER_STORAGE_MB=2048

# ============================================================
# # SONOTA V3.2.0 - IA LOCAL OLLAMA / QWEN
# ============================================================
AI_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434

# # Modelo pequeno: CRUD e consultas simples em uma única inferência.
AI_FAST_ENABLED=true
AI_FAST_MODEL=qwen3:1.7b
AI_FAST_TIMEOUT_SECONDS=60
AI_FAST_CONTEXT=1536
AI_FAST_NUM_PREDICT=128

# # Mesmo Qwen 1.7B em modo agente quando o pedido exige tools/múltiplas etapas.
AGENT_MODEL=qwen3:1.7b
AI_MAX_STEPS=3
AI_MEMORY_MESSAGES=4
AI_TIMEOUT_SECONDS=180
AI_AGENT_CONTEXT=3072
AI_AGENT_NUM_PREDICT=192

# # O Sonota desativa thinking para priorizar velocidade operacional.
AI_THINKING=false
AI_TEMPERATURE=0

# # Mantém o modelo carregado para não pagar o custo de carregamento a cada comando.
AI_KEEP_ALIVE=1h
AI_WARMUP=true
AI_WARMUP_TIMEOUT_SECONDS=120

# # Busca semântica local de arranjos.
EMBEDDING_MODEL=qwen3-embedding:0.6b

# ============================================================
# # PROCESSAMENTO DE ÁUDIO - provisionado pelo instalador V3.2.0
# ============================================================
AUDIO_ENABLED=false
AUDIO_PYTHON=python
AUDIO_TIMEOUT_SECONDS=3600

AI_WARMUP_EMBEDDING=true

# Firebase: referência à credencial existente; arquivo privado não copiado.
FIREBASE_PROJECT_ID="bancodosonotaapp"
GOOGLE_APPLICATION_CREDENTIALS="C:/Users/Diego/OneDrive/Desktop/firebase-credencials/sonota-admin.json.json"
