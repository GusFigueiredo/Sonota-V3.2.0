{
  "name": "sonota-backend",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "description": "Sonota V3.2.0: Início simplificado, Dashboard separado, Biblioteca com busca inteligente integrada, backend Node/Express, SQLite, IA local Ollama portátil e Laboratório com Python portátil",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "node scripts/check.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "ui:install": "npm --prefix mobile install",
    "ui:dev": "npm --prefix mobile run dev",
    "ui:build": "npm --prefix mobile run build",
    "build": "npm --prefix mobile run build",
    "start:full": "npm run ui:build && npm start",
    "desktop:install": "npm --prefix desktop install",
    "desktop:build": "npm --prefix desktop run build",
    "desktop:release": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/windows/build-release.ps1"
  },
  "dependencies": {
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "multer": "2.4.0",
    "music-metadata": "11.16.1",
    "zod": "4.6.5"
  }
}
